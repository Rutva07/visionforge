# AWS usage: use AWS_PROFILE or IAM role, not hard-coded AWS secrets.
STORAGE_BACKEND=s3
S3_BUCKET=YOUR_BUCKET_NAME
S3_PREFIX=visionforge
S3_ENDPOINT_URL=
AWS_DEFAULT_REGION=us-east-1
AWS_PROFILE=YOUR_AWS_PROFILE
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@POSTGRES_HOST:5432/visionforge
IMAGE_CACHE_DIR=./.cache/objects
