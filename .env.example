# Copy to .env. Default setup: locally hosted S3-compatible MinIO + PostgreSQL.
STORAGE_BACKEND=s3
S3_BUCKET=visionforge-images
S3_PREFIX=visionforge
S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=visionforge
AWS_SECRET_ACCESS_KEY=visionforge-dev-only
AWS_DEFAULT_REGION=us-east-1
S3_ADDRESSING_STYLE=path
DATABASE_URL=postgresql+psycopg://visionforge:visionforge@localhost:5432/visionforge
IMAGE_CACHE_DIR=./.cache/objects
LOCAL_STORAGE_DIR=./.local/objects
